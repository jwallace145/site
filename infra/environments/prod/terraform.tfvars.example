# Copy to terraform.tfvars (git-ignored). Only budget_alert_email is required;
# everything else defaults to this project's standards.

budget_alert_email = "you@example.com"

# aws_region         = "us-east-1"
# monthly_budget_usd = 5

# DNS and custom domain. Defaults are this project's values; the zone is
# created first, then domain_name is set once the registrar delegates to it.
# dns_zone_name             = "jwall.engineering"
# domain_name               = "jwall.engineering"
# www_redirect              = true
# preview_use_custom_domain = true
# preview_domain_name       = "preview.jwall.engineering"
# dns_records = {
#   "@"    = { type = "TXT", values = ["v=spf1 -all"] }
#   "mail" = { type = "MX", ttl = 3600, values = ["10 mx.example.net."] }
# }
# Externally managed zone instead: dns_zone_name = null, hosted_zone_id = "Z..."

# The account already has a GitHub OIDC provider, so the default is false.
# Set true only in an account without one.
# create_oidc_provider = false

# Extra tags on top of Project / Owner / Environment / ManagedBy / Repository.
# extra_tags = { CostCenter = "personal" }

# PR previews (https://<preview cdn>/pr-<n>/). All optional.
# preview_enabled                = true
# preview_github_environment     = "preview"
# preview_key_prefix             = "pr-"
# preview_retention_days         = 30
# preview_price_class            = "PriceClass_100"
# preview_robots_tag             = "noindex, nofollow"
# preview_extra_response_headers = { X-Preview = "true" }
