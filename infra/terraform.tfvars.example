# Copy to terraform.tfvars (git-ignored) and fill in. Nothing here is secret,
# but keep account-specific values out of the repo.

aws_region         = "us-east-1"
name               = "jwallace145-site"
budget_alert_email = "you@example.com"
monthly_budget_usd = 5

# Optional custom domain. Both must be set together; leave both unset to use
# the CloudFront domain.
# domain_name    = "example.com"
# hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# Set to false if the account already has a GitHub OIDC provider.
create_oidc_provider = true
